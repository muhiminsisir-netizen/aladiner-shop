# Copy this file to .env and set real values on the server only.
# Never commit .env or place SMTP secrets in browser code.
PUBLIC_URL=https://your-store.example
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=replace-with-your-smtp-password
MAIL_FROM=orders@your-store.example

# Optional: use a strong random value (at least 32 characters).
# SESSION_SECRET=replace-with-a-long-random-secret
